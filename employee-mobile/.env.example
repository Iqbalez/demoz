# Demoz Employee Mobile App — Environment Variables

# For Android emulator pointing at local backend:
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# For iOS simulator pointing at local backend:
EXPO_PUBLIC_API_URL=http://localhost:3001

# For physical device — use your machine's LAN IP:
EXPO_PUBLIC_API_URL=http://192.168.1.x:3001

# For production APK — set this in eas.json, not here:
EXPO_PUBLIC_API_URL=https://your-render-url.onrender.com
