datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

/// System-wide authorization roles for platform users
enum UserRole {
  SUPER_ADMIN
  OWNER
  HR
  EMPLOYEE
}

enum PaymentMethod {
  BANK
  CHAPA_WALLET
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum TenantStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
}

/// Represents subscriber corporate entities (companies) on the Demoz platform
model Tenant {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String       @db.VarChar(255)
  companyCode           String       @unique @db.VarChar(50) // Unique constraint automatically indexes for fast USSD lookups
  tin                   String?      @db.VarChar(20)  // Taxpayer Identification Number — mandatory for ERCA/SIGTAS tax filings
  status                TenantStatus @default(ACTIVE)
  planTier              String       @default("FREE") @db.VarChar(50)
  maxEmployees          Int          @default(10) @db.Integer
  subscriptionExpiresAt DateTime?    @db.Timestamptz(6)
  isActive              Boolean      @default(true) @db.Boolean
  industry              String?      @db.VarChar(100)
  companySize           String?      @db.VarChar(50)
  registrationNumber    String?      @db.VarChar(100)
  address               Json?        @db.JsonB
  contactEmail          String?      @db.VarChar(255)
  contactPhone          String?      @db.VarChar(20)
  fiscalYearStart       Int          @default(7) @db.Integer // 7 for July by default (Ethiopian FY)
  logoUrl               String?      @db.VarChar(500) // TODO: replace with S3
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(6)

  // Relations
  users                User[]
  branches             Branch[]
  departments          Department[]
  employees            Employee[]
  attendances          Attendance[]
  attendanceLogs       AttendanceLog[]
  payrollRuns          PayrollRun[]
  aiAuditReports       AiAuditReport[]
  auditLogs            AuditLog[]
  subscriptionInvoices SubscriptionInvoice[]
  leaveTypes           LeaveType[]
  leaveRequests        LeaveRequest[]
  paymentTransactions  PaymentTransaction[]
  invitations          Invitation[]
  payrollConfig        PayrollConfig?
  attendanceConfig     AttendanceConfig?
  securityConfig       SecurityConfig?
  notificationConfig   NotificationConfig?
  customRoles          CustomRole[]
  tenantHolidays       TenantHoliday[]
  userNotificationPreferences UserNotificationPreference[]
  integrationConfig    IntegrationConfig?

  @@index([status, subscriptionExpiresAt])
  @@map("tenants") // Maps Prisma model to plural lowercase PostgreSQL table name
}

/// Represents individual user accounts belonging to subscriber companies
model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Null only for platform SUPER_ADMIN accounts
  tenantId     String?  @db.Uuid
  email        String   @db.VarChar(255)
  /// Null for Google-only accounts until first password set
  passwordHash String?  @db.VarChar(255)
  googleId     String?  @unique @db.VarChar(255)
  phoneNumber  String   @unique @db.VarChar(20) // Globally unique for USSD credentials lookup
  role             UserRole
  /// @encrypted
  twoFactorSecret  String?
  customRoleId     String?  @db.Uuid
  isActive         Boolean  @default(true) @db.Boolean
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee     Employee?
  customRole   CustomRole?    @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  approvedLeaves LeaveRequest[]
  notificationPreferences UserNotificationPreference[]

  // Indexes & Constraints
  @@unique([tenantId, email], name: "tenant_email_unique") // Strict tenant-level email uniqueness
  @@index([tenantId]) // Index foreign key for optimal join performance
  @@index([phoneNumber]) // Explicit index for fast USSD authentication
  @@map("users") // Maps Prisma model to plural lowercase PostgreSQL table name
}

model Branch {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @db.Uuid
  name                 String       @db.VarChar(255)
  location             String?      @db.VarChar(255)
  latitude             Decimal?     @db.Decimal(10, 8)
  longitude            Decimal?     @db.Decimal(11, 8)
  geofenceRadiusMeters Int          @default(100) @db.Integer
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  attendanceLogs AttendanceLog[]

  @@index([tenantId])
  @@index([tenantId, id])
  @@map("branches")
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  branchId  String     @db.Uuid
  name      String     @db.VarChar(255)
  parentId  String?    @db.Uuid
  managerId String?    @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parent    Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentHierarchy")
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees Employee[]

  @@index([tenantId])
  @@index([tenantId, id])
  @@map("departments")
}

model Employee {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @db.Uuid
  userId             String?         @unique @db.Uuid
  departmentId       String          @db.Uuid
  firstName          String          @db.VarChar(100)
  lastName           String          @db.VarChar(100)
  employeeIdNumber   String          @db.VarChar(50)
  phoneNumber        String          @unique @db.VarChar(20)
  /// @encrypted
  tin                String?  // Taxpayer Identification Number — mandatory for ERCA/SIGTAS monthly tax filing
  /// @encrypted
  pensionId          String?  // POESSA Pension ID — mandatory for monthly pension contribution reporting
  baseSalary         Decimal         @db.Decimal(12, 2) // Decimal ensures high accuracy for payroll financial calculations
  transportAllowance Decimal         @default(0) @db.Decimal(12, 2) // Non-taxable up to 25% of basic or 2,200 ETB
  positionAllowance  Decimal         @default(0) @db.Decimal(12, 2) // Taxable position/responsibility allowance
  paymentMethod      PaymentMethod   @default(BANK)
  bankName           String?         @db.VarChar(100)
  /// @encrypted
  bankAccount        String?
  bankCode           String?         @db.VarChar(50)
  /// @encrypted
  accountName        String?
  status             EmployeeStatus  @default(ACTIVE)
  ussdPin            String?         @db.VarChar(4) @default("1234") // Default USSD PIN for simple frontend authorization
  ussdPinHash        String?         @db.VarChar(255)
  /// @encrypted
  faydaNumber        String?         @unique
  hireDate           DateTime        @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  suspensionReason   String?         @db.Text
  suspensionDate     DateTime?       @db.Timestamptz(6)
  finalPayInfo       Json?           @db.JsonB
  managerId          String?         @db.Uuid
  leaveBalanceUsed   Int             @default(0) @db.Integer
  leaveYear          Int             @default(2024) @db.Integer

  // Relations
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  managedDepartments Department[]    @relation("DepartmentManager")
  manager            Employee?       @relation("EmployeeToManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       Employee[]      @relation("EmployeeToManager")
  attendances        Attendance[]
  attendanceLogs     AttendanceLog[]
  payrollLineItems   PayrollLineItem[]
  leaveRequests      LeaveRequest[]

  // Composite indexes make searching incredibly fast within a company context
  @@unique([tenantId, employeeIdNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([phoneNumber])
  @@map("employees")
}

model Attendance {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  employeeId           String    @db.Uuid
  date                 DateTime  @db.Date
  checkInTime          DateTime  @db.Timestamptz(6)
  checkOutTime         DateTime? @db.Timestamptz(6)
  checkInLatitude      Decimal?  @db.Decimal(10, 8)
  checkInLongitude     Decimal?  @db.Decimal(11, 8)
  checkOutLatitude     Decimal?  @db.Decimal(10, 8)
  checkOutLongitude    Decimal?  @db.Decimal(11, 8)
  checkInMethod        String    @db.VarChar(50) // 'PWA' or 'USSD'
  checkOutMethod       String?   @db.VarChar(50) // 'PWA' or 'USSD'
  status               String    @db.VarChar(50) // 'PRESENT', 'ABSENT', 'LATE', 'INFRACTION', etc.
  complianceInfraction Boolean   @default(false)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date]) // Ensures atomic single-check-in per day per employee
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([tenantId, date])
  @@map("attendance")
}

enum AttendanceSource {
  USSD
  WEB_PWA
}

enum AttendanceType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum AttendanceMethod {
  GPS
  USSD
  QR
  MANUAL_OVERRIDE
}

model AttendanceLog {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  employeeId    String           @db.Uuid
  timestamp     DateTime         @default(now()) @db.Timestamptz(6)
  type          AttendanceType
  source        AttendanceSource
  latitude      Decimal?         @db.Decimal(10, 8)
  longitude     Decimal?         @db.Decimal(11, 8)
  accuracy      Float?           @db.DoublePrecision
  method        AttendanceMethod @default(GPS)
  syncedAt      DateTime?        @db.Timestamptz(6)
  wasOfflineSync Boolean         @default(false)
  deviceId      String?          @db.VarChar(255)
  clientTime    DateTime?        @db.Timestamptz(6)
  branchId      String?          @db.Uuid
  isAnomaly     Boolean          @default(false)
  anomalyReason String?          @db.VarChar(255)
  telemetry     Json             @default("{}")

  // Relations
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, timestamp])
  @@map("attendance_logs")
}

enum PayrollStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DRAFT
  AI_AUDITED
  OWNER_APPROVED
  PROCESSING_PAYOUT
  PAID
  PAYOUT_FAILED
}

enum PayoutStatus {
  PENDING
  SUCCESS
  FAILED
}

model PayrollRun {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  status       PayrollStatus @default(PENDING)
  periodStart  DateTime      @db.Timestamptz(6)
  periodEnd    DateTime      @db.Timestamptz(6)
  totalGross   Decimal       @default(0) @db.Decimal(12, 2)
  totalNet     Decimal       @default(0) @db.Decimal(12, 2)
  totalTax     Decimal       @default(0) @db.Decimal(12, 2)
  errorMessage String?       @db.Text
  periodLabelEC String?      @db.VarChar(100)
  periodLabelGC String?      @db.VarChar(100)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollLineItems PayrollLineItem[]
  aiAuditReport    AiAuditReport?

  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("payroll_runs")
}

model PayrollLineItem {
  id                           String   @id @default(uuid()) @db.Uuid
  payrollRunId                 String   @db.Uuid
  employeeId                   String   @db.Uuid
  baseSalary                   Decimal  @db.Decimal(12, 2)
  transportAllowance           Decimal  @default(0) @db.Decimal(12, 2)  // Gross transport allowance for this period
  transportAllowanceExempt     Decimal  @default(0) @db.Decimal(12, 2)  // Non-taxable portion (min of 25% base or 2200)
  taxableAllowances            Decimal  @default(0) @db.Decimal(12, 2)
  overtimePay                  Decimal  @default(0) @db.Decimal(12, 2)  // Calculated overtime earnings
  /// @encrypted
  grossSalary                  Decimal  @default(0) @db.Decimal(12, 2)  // Base + allowances + overtime
  incomeTax                    Decimal  @default(0) @db.Decimal(12, 2)
  pensionDeduction             Decimal  @default(0) @db.Decimal(12, 2)  // 7% employee share
  employerPensionContribution  Decimal  @default(0) @db.Decimal(12, 2)  // 11% employer share (audit trail)
  netPay                       Decimal  @default(0) @db.Decimal(12, 2)
  /// @encrypted
  bankAccount                  String?  @db.VarChar(255)
  bankCode                     String?  @db.VarChar(50)
  disbursed                    Boolean  @default(false) @db.Boolean
  chapaReference               String?      @unique @db.VarChar(255)
  payoutStatus                 PayoutStatus @default(PENDING)
  createdAt                    DateTime     @default(now()) @db.Timestamptz(6)

  // Relations
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_line_items")
}

model AiAuditReport {
  id                String   @id @default(uuid()) @db.Uuid
  payrollRunId      String   @unique @db.Uuid
  tenantId          String   @db.Uuid
  totalLogsAnalyzed Int      @db.Integer
  fraudRiskScore    Float    @db.DoublePrecision
  flaggedEmployeeIds Json    @db.JsonB
  insightsSummary   String   @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ai_audit_reports")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  action    String   @db.VarChar(255)
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Append-only chronological index
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model SubscriptionInvoice {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  amount                Decimal  @db.Decimal(12, 2)
  currency              String   @default("ETB") @db.VarChar(3)
  billingPeriodStart    DateTime @db.Timestamptz(6)
  billingPeriodEnd      DateTime @db.Timestamptz(6)
  isPaid                Boolean  @default(false) @db.Boolean
  chapaPaymentReference String?  @unique @db.VarChar(255)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPaid])
  @@map("subscription_invoices")
}

/// Ethiopian Public Holidays calendar — used by overtime engine for 2.5x holiday multiplier
/// Source: docs/ethiopia_2026_holidays.md
model PublicHoliday {
  id           String   @id @default(uuid()) @db.Uuid
  date         DateTime @db.Date
  nameEn       String   @db.VarChar(150) // English name
  nameAm       String?  @db.VarChar(150) // Amharic name
  ethiopicDate String?  @db.VarChar(50)  // Ethiopic calendar date string
  multiplier   Decimal  @default(2.5) @db.Decimal(3, 1) // Overtime multiplier per Labor Proclamation 1156/2019
  year         Int      @db.Integer
  isRecurring  Boolean  @default(true) @db.Boolean
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  tenantHolidays TenantHoliday[]

  @@unique([date, year])
  @@index([year])
  @@index([date])
  @@map("public_holidays")
}

/// Ethiopian Labor Law Leave Types
model LeaveType {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  name             String   @db.VarChar(100) // "Annual Leave", "Sick Leave"
  code             String   @db.VarChar(20) // "AL", "SL"
  maxDaysPerYear   Int
  requiresApproval Boolean  @default(true)
  isPaid           Boolean  @default(true)
  accrualMethod    String   @default("UPFRONT") @db.VarChar(50) // UPFRONT, MONTHLY, MANUAL
  carryover        Boolean  @default(false) @db.Boolean
  carryoverMax     Int      @default(0) @db.Integer
  genderRestriction String? @db.VarChar(20) // MALE, FEMALE
  minDaysPerReq    Int      @default(1) @db.Integer
  noticePeriodDays Int      @default(0) @db.Integer
  requiresDocumentation Boolean @default(false) @db.Boolean
  isSystem         Boolean  @default(false) @db.Boolean
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  requests         LeaveRequest[]
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("leave_types")
}

/// Employee Leave Requests
model LeaveRequest {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  employeeId       String   @db.Uuid
  leaveTypeId      String   @db.Uuid
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  totalDays        Int
  reason           String?  @db.Text
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedById     String?  @db.Uuid
  approvedAt       DateTime? @db.Timestamptz(6)
  rejectionReason  String?  @db.Text
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvedBy       User?     @relation(fields: [approvedById], references: [id])

  @@index([tenantId, status])
  @@index([employeeId])
  @@map("leave_requests")
}

enum PaymentStatus {
  INITIATED
  PENDING
  WEBHOOK_RECV
  VERIFIED
  COMPLETED
  FAILED
  REFUNDED
}

model PaymentTransaction {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  txRef          String        @unique @db.VarChar(255)
  chapaRef       String?       @unique @db.VarChar(255)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("ETB") @db.VarChar(3)
  status         PaymentStatus @default(INITIATED)
  webhookPayload Json?         @db.JsonB
  retryCount     Int           @default(0) @db.Integer
  lastRetryAt    DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime?     @db.Timestamptz(6)
  
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([txRef])
  @@index([tenantId, status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model Invitation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  role      UserRole
  status    String   @default("PENDING") @db.VarChar(50)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([token])
  @@map("invitations")
}

model ReportDownloadLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  reportType   String   @db.VarChar(50) // 'ERCA' | 'POESSA' | 'LEAVE_LIABILITY'
  periodYear   Int      @db.Integer
  periodMonth  Int      @db.Integer
  downloadedAt DateTime @default(now()) @db.Timestamptz(6)
  downloadedBy String   @db.Uuid // userId

  @@index([tenantId, reportType, periodYear, periodMonth], name: "idx_report_download")
  @@map("report_download_logs")
}

model PayrollConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @db.Uuid
  pensionEmployee  Decimal  @default(7.0) @db.Decimal(5, 2)
  pensionEmployer  Decimal  @default(11.0) @db.Decimal(5, 2)
  pensionCap       Decimal  @default(5000) @db.Decimal(12, 2)
  payFrequency     String   @default("MONTHLY") @db.VarChar(50)
  cutoffDay        Int      @default(25) @db.Integer
  payDate          Int      @default(28) @db.Integer
  overtimeRate     Decimal  @default(1.25) @db.Decimal(5, 2)
  nightShiftRate   Decimal  @default(0) @db.Decimal(12, 2)
  nightShiftEnabled Boolean @default(false) @db.Boolean
  payslipTemplate  Json?    @db.JsonB
  allowanceTypes   Json?    @db.JsonB
  deductionTypes   Json?    @db.JsonB

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("payroll_configs")
}

model AttendanceConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @db.Uuid
  workHoursPerDay  Int      @default(8) @db.Integer
  workDays         Json     @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\",\"SAT\"]") @db.JsonB
  dailyOvertimeThresh Int   @default(8) @db.Integer
  weeklyOvertimeThresh Int  @default(48) @db.Integer
  gracePeriodMins  Int      @default(15) @db.Integer
  autoAbsentMins   Int      @default(120) @db.Integer
  offlineSync      Boolean  @default(true) @db.Boolean
  shifts           Json?    @db.JsonB

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("attendance_configs")
}

model SecurityConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @db.Uuid
  minPasswordLen   Int      @default(8) @db.Integer
  requireUppercase Boolean  @default(true) @db.Boolean
  requireNumber    Boolean  @default(true) @db.Boolean
  requireSpecial   Boolean  @default(false) @db.Boolean
  passwordExpiryDays Int?   @db.Integer
  failedLoginLock  Int      @default(5) @db.Integer
  sessionTimeoutMins Int    @default(60) @db.Integer
  allowMultiSession Boolean @default(true) @db.Boolean
  require2FA       String   @default("NONE") @db.VarChar(50) // NONE, ADMINS, ALL

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("security_configs")
}

model NotificationConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @db.Uuid
  payrollReminderDays Int   @default(3) @db.Integer
  leaveApprovalAlert Boolean @default(true) @db.Boolean
  attendanceAnomalyAlert Boolean @default(true) @db.Boolean
  taxRemittanceAlert Boolean @default(true) @db.Boolean
  
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("notification_configs")
}

model CustomRole {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  name             String   @db.VarChar(100)
  description      String?  @db.Text
  isSystem         Boolean  @default(false) @db.Boolean
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  
  permissions      RolePermission[]
  users            User[]
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("custom_roles")
}

model RolePermission {
  id               String   @id @default(uuid()) @db.Uuid
  roleId           String   @db.Uuid
  permission       String   @db.VarChar(100)
  
  role             CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model TenantHoliday {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  publicHolidayId  String?  @db.Uuid // Linked if overriding a national holiday
  date             DateTime @db.Date
  name             String   @db.VarChar(150)
  isObserved       Boolean  @default(true) @db.Boolean
  isCustom         Boolean  @default(true) @db.Boolean
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  publicHoliday    PublicHoliday? @relation(fields: [publicHolidayId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("tenant_holidays")
}

model UserNotificationPreference {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @db.Uuid
  userId                   String   @db.Uuid
  payrollReminderDays      Int      @default(3) @db.Integer
  leaveApprovalAlert       Boolean  @default(true) @db.Boolean
  attendanceAnomalyAlert   Boolean  @default(true) @db.Boolean
  taxRemittanceAlert       Boolean  @default(true) @db.Boolean
  subscriptionRenewalAlert Boolean  @default(true) @db.Boolean
  quietHoursEnabled        Boolean  @default(false) @db.Boolean
  quietHoursStart          String?  @db.VarChar(5) // HH:mm format
  quietHoursEnd            String?  @db.VarChar(5) // HH:mm format

  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("user_notification_preferences")
}

model IntegrationConfig {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @unique @db.Uuid
  chapaApiKey             String?  @db.VarChar(500) // @encrypted
  chapaConnected          Boolean  @default(false) @db.Boolean
  cbeAccountNumber        String?  @db.VarChar(50)
  awashAccountNumber      String?  @db.VarChar(50)
  ercaRegistrationNumber  String?  @db.VarChar(50)
  psssaRegistrationNumber String?  @db.VarChar(50)
  lastWebhookReceived     DateTime? @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @db.Timestamptz(6)

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("integration_configs")
}