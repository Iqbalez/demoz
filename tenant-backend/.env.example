# Database
DATABASE_URL=postgresql://user:password@host:5432/demoz

# Authentication
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars

# Upstash Redis for KPI Caching
UPSTASH_REDIS_URL=rediss://default:password@endpoint.upstash.io:6379

# Chapa Payment Gateway
CHAPA_SECRET_KEY=CHASECK_live_xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=replace_with_chapa_webhook_secret

# Application
NODE_ENV=development

# AfroMessage SMS (optional - warns on startup if missing)
AFROMESSAGE_API_KEY=replace_with_afromessage_key
AFROMESSAGE_SENDER_NAME=Demoz