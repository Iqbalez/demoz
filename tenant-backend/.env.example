# Database (Neon — use the *pooler* URL on Render)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Auth (RS256 — required on Render)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Redis (Upstash — preferred)
UPSTASH_REDIS_URL=rediss://default:PASSWORD@endpoint.upstash.io:6379

# Chapa
CHAPA_SECRET_KEY=CHASECK_live_xxx
CHAPA_WEBHOOK_SECRET=your_webhook_secret

# URLs (no trailing slash)
FRONTEND_URL=https://demoz-rho.vercel.app
BACKEND_URL=https://demoz-tfts.onrender.com

# Google Sign-In (OAuth 2.0 Web client — same ID as Vercel NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# App
NODE_ENV=production
PORT=10000

# Prisma field encryption
# Required. Generate with: openssl rand -base64 32
PRISMA_FIELD_ENCRYPTION_KEY=

# Optional
SENTRY_DSN=
AFROMESSAGE_API_KEY=
AFROMESSAGE_SENDER_NAME=Demoz

# Super Admin seed (run locally once — do not commit real password)
# SUPER_ADMIN_EMAIL=iqbalezedin@gmail.com
# SUPER_ADMIN_PASSWORD=
